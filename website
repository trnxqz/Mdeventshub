const PTS_KEY='meh_points';
function getPoints(){ return JSON.parse(localStorage.getItem(PTS_KEY)||'{}'); }
function setPoints(obj){ localStorage.setItem(PTS_KEY, JSON.stringify(obj)); }
function addPoints(email,delta){
  if(!email) return;
  const pts=getPoints(); pts[email]=(pts[email]||0)+delta; setPoints(pts);
  if(currentUser()?.email===email) $('#pointsMe').textContent=pts[email]||0;
  updateLeaderboard();
}
function shortEmail(e){ const [u,d]=e.split('@'); return u.slice(0,3)+'…@'+d; }
function avatarColor(seed){ const hues=[200,210,220,230,240,260,280,300]; return `hsl(${hues[Math.abs(hash(seed))%hues.length]} 70% 45%)`; }
function hash(s){let h=0; for(let i=0;i<s.length;i++) h=(h<<5)-h+s.charCodeAt(i)|0; return h;}
const BADGES=[{p:10,n:'Rookie'},{p:25,n:'Trailblazer'},{p:50,n:'Event Hunter'},{p:100,n:'Community Hero'}];
function badgeFor(p){ let b=BADGES[0]; for(const x of BADGES){ if(p>=x.p) b=x; } return b; }
function progressToNext(p){ const nxt=BADGES.find(x=>x.p>p); if(!nxt) return 100; const prev=badgeFor(p).p; return Math.min(100, Math.round(((p-prev)/(nxt.p-prev))*100)); }
function updateLeaderboard(){
  const pts=getPoints();
  const entries=Object.entries(pts).map(([email,p])=>({email,p})).sort((a,b)=>b.p-a.p).slice(0,10);
  $('#lbList').innerHTML = entries.length? entries.map(({email,p},i)=>{
    const badge=badgeFor(p); const prog=progressToNext(p);
    const av=`<div class="avatar" style="background:${avatarColor(email)}">${email[0].toUpperCase()}</div>`;
    return `<li class="lb-item">
      ${av}
      <div>
        <div class="lb-name">${email.split('@')[0]}</div>
        <div class="lb-email">${shortEmail(email)}</div>
        <div class="progress" style="margin-top:6px"><span style="width:${prog}%"></span></div>
      </div>
      <div style="display:grid;justify-items:end;gap:6px">
        <div class="badge">${badge.n}</div>
        <div style="font-weight:900">${p}p</div>
      </div>
    </li>`;
  }).join('') : '<li class="lb-item"><div style="grid-column:1/-1;color:var(--muted)">Încă nu sunt puncte</div></li>';
  const me=currentUser()?.email; $('#pointsMe').textContent = me? (pts[me]||0) : 0;
  const myP=me?(pts[me]||0):0; $('#lbProg').style.width=progressToNext(myP)+'%';
}
