<style>
:root{
  --brand:#31A8FF; --brand-ink:#001119; --dark:#001E36; --accent:#FDCC04;
  --txt:#0f172a; --muted:#5b6b82; --muted2:#7b8aa1;
  --bg:#ffffff; --paper:#ffffff; --paper-2:#f5f8fe;
  --ring:rgba(49,168,255,.35); --shadow:0 18px 44px rgba(2,26,48,.10);
}
[data-theme="dark"]{
  --txt:#e9f3ff; --muted:#b8c6d9; --muted2:#9fb2cc;
  --bg:#07101b; --paper:#0b1421; --paper-2:#0d1624;
  --shadow:0 22px 54px rgba(0,0,0,.45);
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Helvetica Neue,Arial;background:var(--bg);color:var(--txt);-webkit-tap-highlight-color:transparent}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%;height:auto}
button{font:inherit}
.no-js .needs-js{display:none}

/* NAV */
.nav{position:sticky;top:0;z-index:70;background:rgba(255,255,255,.86);backdrop-filter:blur(10px);border-bottom:1px solid rgba(0,0,0,.06)}
[data-theme="dark"] .nav{background:rgba(6,18,33,.9);border-bottom-color:rgba(255,255,255,.08)}
.nav-inner{width:min(1200px,94%);margin:auto;display:flex;align-items:center;gap:10px;padding:6px 0}
.brand{display:flex;align-items:center;gap:10px;min-width:132px}
.brand img{height:30px;object-fit:contain}
@media (max-width:420px){.brand img{height:26px}}
.links{display:flex;align-items:center;gap:2px;margin-left:6px}
.links a{padding:8px 10px;border-radius:10px;color:var(--muted);font-weight:800;white-space:nowrap}
.links a.active{background:rgba(49,168,255,.12);color:var(--dark)}
.nav-cta{margin-left:auto;display:flex;align-items:center;gap:6px}
.iconbtn{width:34px;height:34px;border-radius:10px;border:1px solid rgba(0,0,0,.08);background:var(--paper);display:grid;place-items:center}
[data-theme="dark"] .iconbtn{border-color:rgba(255,255,255,.14)}
.cta,.btn{position:relative;overflow:hidden}
.cta{background:var(--brand);color:var(--brand-ink);padding:8px 12px;border-radius:12px;border:none;font-weight:900;box-shadow:0 10px 28px rgba(49,168,255,.35)}
.menu-btn{display:none;border:1px solid rgba(0,0,0,.1);padding:8px 10px;border-radius:10px;background:#fff}
.menu-btn span{display:block;width:20px;height:2px;background:var(--dark);margin:4px 0;border-radius:2px}
.auth-buttons{display:flex;gap:6px}
.auth-buttons .btn{padding:8px 10px;border-radius:10px;border:1px solid rgba(0,0,0,.08);background:#fff;font-weight:900}
.auth-buttons .btn.primary{background:#e6f4ff;border-color:#bfe6ff}
@media (max-width:980px){.links{display:none}.menu-btn{display:block}}

/* Mobile drawer */
.mobile{position:fixed;inset:56px 0 auto 0;display:none;background:var(--paper);border-top:1px solid rgba(0,0,0,.06);z-index:79}
.mobile.open{display:block;animation:slide .18s ease-out}
.mobile a,.mobile button{display:block;padding:14px 5%;border:none;background:transparent;font-weight:800;text-align:left}
@keyframes slide{from{transform:translateY(-8px);opacity:.6}to{transform:none;opacity:1}}

/* HERO */
.hero{position:relative;isolation:isolate;min-height:50vh;display:grid;place-items:center;text-align:center}
.hero::before{content:"";position:absolute;inset:0;z-index:-2;background:url('https://images.pexels.com/videos/16953741/adunarea-na-ionala-moldova-europeana-16953741.jpeg') center/cover no-repeat;filter:saturate(112%) contrast(108%) brightness(1.06)}
.hero::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg, rgba(0,30,54,.48), rgba(0,30,54,.18) 40%, rgba(0,30,54,.6))}
.hero-inner{width:min(1200px,92%);margin:auto;color:#fff;padding:38px 0}
.eyebrow{display:inline-flex;gap:8px;align-items:center;background:rgba(253,204,4,.18);border:1px solid rgba(253,204,4,.5);padding:6px 12px;border-radius:999px;font-weight:900}
.hero h1{font-size:clamp(26px,5vw,46px);margin:16px 0 8px;line-height:1.06;text-shadow:0 8px 30px rgba(0,0,0,.35)}
.hero p{max-width:980px;margin:0 auto 18px;opacity:.98;font-size:clamp(15px,2vw,19px)}

/* SEARCH */
.search{position:relative;z-index:2;display:grid;grid-template-columns:2fr 1.2fr 1fr 1fr .9fr;gap:8px;width:min(1240px,96%);margin:14px auto 0;background:rgba(255,255,255,.92);padding:10px;border-radius:12px;border:1px solid rgba(0,0,0,.05);backdrop-filter:blur(2px)}
[data-theme="dark"] .search{background:rgba(12,20,33,.78);border-color:rgba(255,255,255,.14)}
.search :is(input,select,button){padding:11px 12px;border-radius:10px;border:1px solid rgba(0,0,0,.08);outline:none;background:#fff}
[data-theme="dark"] .search :is(input,select){background:#0b1421;border-color:rgba(255,255,255,.14);color:var(--txt)}
.search :is(input,select):focus{box-shadow:0 0 0 4px var(--ring)}
.search button{background:var(--accent);font-weight:900;border:none}
@media (max-width:1100px){.search{grid-template-columns:1fr;border-radius:12px}}

/* Sections */
.section{padding:40px 0}
.section .container{width:min(1200px,92%);margin:auto}
.hflex{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:14px;flex-wrap:wrap}
.h2{font-size:clamp(22px,2.6vw,32px)}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:8px 12px;border-radius:999px;border:1px solid rgba(0,0,0,.08);background:var(--paper);color:var(--muted);font-weight:800;cursor:pointer}
[data-theme="dark"] .chip{border-color:rgba(255,255,255,.12)}
.chip.active{border-color:var(--brand);box-shadow:inset 0 0 0 1.5px var(--brand);color:var(--dark)}

/* Grid & cards */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
@media (max-width:1040px){.grid{grid-template-columns:repeat(2,1fr)}}
@media (max-width:680px){.grid{grid-template-columns:1fr}}
.card{background:var(--paper);border:1px solid rgba(0,0,0,.06);border-radius:22px;overflow:hidden;box-shadow:var(--shadow);display:grid;grid-template-rows:auto 1fr auto;transition:transform .15s}
.focus .card:hover{transform:scale(1.01)}
[data-theme="dark"] .card{border-color:rgba(255,255,255,.08)}
.thumb{position:relative;aspect-ratio:16/9;overflow:hidden}
.thumb::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(0,0,0,.08))}
.thumb img{width:100%;height:100%;object-fit:cover;transform:scale(1.02)}
.badge-scope{position:absolute;top:10px;left:10px;background:var(--accent);color:#001e36;padding:6px 10px;border-radius:999px;font-weight:900;font-size:12px}
.badge-price{position:absolute;top:10px;right:10px;background:#fff;color:#0b2440;padding:6px 10px;border-radius:999px;border:1px solid rgba(0,0,0,.08);font-weight:900;font-size:12px}
.favorite-fab{position:absolute;right:10px;bottom:10px;background:rgba(255,255,255,.96);border-radius:999px;padding:7px;border:1px solid rgba(0,0,0,.07);cursor:pointer}
.card-body{padding:12px;display:grid;gap:8px}
.card-title{font-size:18px;font-weight:900}
.meta{display:grid;gap:6px;color:var(--muted);font-size:14px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font-size:12px;font-weight:900;color:#001e36;background:#e6f5ff;border:1px solid #bfe6ff;padding:6px 10px;border-radius:999px}
[data-theme="dark"] .tag{color:#001e36;background:#e6f5ff}
.card-footer{display:flex;align-items:center;justify-content:space-between;padding:12px;border-top:1px solid rgba(0,0,0,.06);background:var(--paper)}
.price-compact{font-weight:900;color:#31A8FF}
.btn{background:var(--brand);color:#00101c;border:none;padding:9px 12px;border-radius:12px;font-weight:900;cursor:pointer}
.btn.ghost{background:transparent;border:1px solid rgba(0,0,0,.12);color:var(--muted)}
[data-theme="dark"] .btn.ghost{border-color:rgba(255,255,255,.14);color:#cfe6ff}
.btn.secondary{background:#e6f5ff;color:#001e36;border:1px solid #bfe6ff}
[data-theme="dark"] .btn.secondary{background:#0f243a;color:#cfe6ff;border-color:#2b5276}
.detailsBtn{box-shadow:0 8px 18px rgba(49,168,255,.25);transition:transform .12s,box-shadow .25s}
.detailsBtn:hover{transform:translateY(-1px);box-shadow:0 14px 26px rgba(49,168,255,.35)}
.likeBtn{display:inline-flex;align-items:center;gap:8px}

/* Footer */
footer{background:#f9fcff;color:#0d2a44;padding:32px 0 56px;margin-top:36px;border-top:1px solid #e6eef7}
[data-theme="dark"] footer{background:#061523;border-top-color:#0b2a46;color:#d2e8ff}
.footer-grid{width:min(1200px,92%);margin:auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:16px}
@media (max-width:860px){.footer-grid{grid-template-columns:1fr}}
.footer-col a{color:#1b4b78;display:block;padding:6px 0;font-size:14px}
[data-theme="dark"] .footer-col a{color:#9dc8ff}
.badges img{height:42px}
.copyright{width:min(1200px,92%);margin:16px auto 0;color:#2b5276;font-size:14px;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
[data-theme="dark"] .copyright{color:#9cc7ff}

/* Dialogs + toast */
dialog::backdrop{background:rgba(0,0,0,.45)}
#evDlg,#authDlg{border:none;border-radius:22px;padding:0;width:min(900px,95%);overflow:hidden;box-shadow:0 40px 120px rgba(0,0,0,.35);transform-origin:top right;animation:pop-in .45s cubic-bezier(.2,.8,.25,1.2)}
@keyframes pop-in{0%{transform:translate(20px,-20px) scale(.92) rotate(-2deg);opacity:0}60%{transform:translate(0,0) scale(1.02)}100%{transform:none;opacity:1}}
.dhead{display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:linear-gradient(90deg,#001E36,#053055);color:#fff}
.dbody{display:grid;grid-template-columns:1fr 300px;gap:14px;padding:14px;background:var(--paper)}
@media (max-width:860px){.dbody{grid-template-columns:1fr}}
.input, select, textarea{padding:11px;border-radius:12px;border:1px solid rgba(0,0,0,.12)}
[data-theme="dark"] .input,[data-theme="dark"] select,[data-theme="dark"] textarea{background:#0b1421;border-color:rgba(255,255,255,.14);color:var(--txt)}
.toast{position:fixed;bottom:14px;left:50%;transform:translateX(-50%);background:#065f46;color:#fff;padding:10px 14px;border-radius:12px;box-shadow:0 10px 28px rgba(0,0,0,.22);z-index:90}

/* Misc */
.backTop{position:fixed;right:12px;bottom:12px;border-radius:999px;padding:12px 14px;border:1px solid #cfe6ff;background:#fff;color:#0b2842;box-shadow:0 10px 26px rgba(0,0,0,.12);display:none}
.backTop.show{display:block}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.hidden{display:none !important}

/* Leaderboard */
.lb-list{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.lb-item{display:grid;grid-template-columns:52px 1fr auto;gap:10px;align-items:center;background:var(--paper);border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:8px}
.avatar{width:52px;height:52px;border-radius:999px;display:grid;place-items:center;font-weight:900;color:#fff}
.lb-name{font-weight:900}
.lb-email{color:var(--muted);font-size:12px}
.badge{border:1px dashed #bfe6ff;background:#e6f5ff;color:#093457;padding:4px 8px;border-radius:999px;font-size:12px;font-weight:900}
.progress{height:8px;background:#e6f1fb;border-radius:999px;overflow:hidden}
.progress>span{display:block;height:100%;background:linear-gradient(90deg,#31A8FF,#7cc8ff)}
.lb-you{font-size:14px;color:var(--muted)}

/* EVENT LANDING – media */
.media-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
.uploader{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.uploader input[type="file"]{display:none}
.uploader label{border:1px dashed #bfe6ff;background:#e6f5ff;color:#093457;padding:8px 12px;border-radius:12px;cursor:pointer;font-weight:800}
[data-theme="dark"] .uploader label{background:#0f243a;border-color:#2b5276;color:#cfe6ff}

.slider{position:relative;border:1px solid rgba(0,0,0,.08);border-radius:16px;overflow:hidden;background:var(--paper-2)}
.slider-track{display:flex;gap:8px;overflow-x:auto;scroll-snap-type:x mandatory;padding:8px}
.slide{min-width:70%;max-width:70%;scroll-snap-align:center;position:relative;border-radius:12px;overflow:hidden;box-shadow:var(--shadow);background:#000}
.slide img,.slide video{width:100%;height:100%;object-fit:cover;display:block}
.slider-nav{position:absolute;inset:auto 0 8px 0;display:flex;justify-content:center;gap:6px}
.dot{width:8px;height:8px;border-radius:999px;background:#bcd7ef;opacity:.6}
.dot.active{opacity:1;background:#31A8FF}
.snav-btn{position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.9);border:1px solid rgba(0,0,0,.1);width:36px;height:36px;border-radius:10px;display:grid;place-items:center;cursor:pointer}
.snav-prev{left:8px}.snav-next{right:8px}

/* CREATOR */
.creator-grid{display:grid;grid-template-columns:280px 1fr;gap:16px;align-items:center}
@media (hover:none) and (pointer:coarse){.creator-grid{grid-template-columns:1fr}}

/* —— PARTNERS (vizibil & clar) —— */
.partners{background:linear-gradient(180deg,#f6fbff,#eef6ff);border-top:1px solid #dfefff;border-bottom:1px solid #dfefff}
[data-theme="dark"] .partners{background:linear-gradient(180deg,#071429,#0c1d36);border-top-color:#0e274d;border-bottom-color:#0e274d}
.partners .container{width:min(1200px,92%);margin:auto;padding:22px 0}
.partners-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.partners-head h3{margin:0;font-size:clamp(18px,2.2vw,22px)}
.partner-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
@media (max-width:900px){.partner-grid{grid-template-columns:repeat(3,1fr)}}
@media (max-width:520px){.partner-grid{grid-template-columns:repeat(2,1fr)}}
.partner{background:var(--paper);border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:12px;display:grid;place-items:center;min-height:90px;box-shadow:var(--shadow)}
.partner img{max-height:40px;filter:grayscale(100%) contrast(1.1);opacity:.95}
.partner:hover img{filter:none;opacity:1}

/* Carousel (secundar) */
.pcar{position:relative;margin-top:14px}
.ptrack{display:flex;gap:18px;overflow:hidden;scroll-behavior:smooth}
.pitem{flex:0 0 auto;background:var(--paper);border:1px solid rgba(0,0,0,.06);border-radius:14px;padding:12px;display:grid;place-items:center;min-width:220px;min-height:90px;box-shadow:var(--shadow)}
.pitem img{max-height:40px;filter:grayscale(100%) contrast(1.1);opacity:.95}
.pnav{display:flex;gap:8px}
.pbtn{border:1px solid rgba(0,0,0,.1);background:#fff;padding:8px 10px;border-radius:10px;cursor:pointer}
</style>
<script>document.documentElement.classList.remove('no-js');</script>
</head>
<body>

<!-- NAV -->
<nav class="nav" id="nav">
  <div class="nav-inner">
    <a class="brand" href="#" id="logoLink" aria-label="MoldovaEventsHub - Refresh">
      <img id="brandLogo" src="https://ik.imagekit.io/hyfme5nmo/MDEVENTSHUB.png?updatedAt=1754845452470" alt="MoldovaEventsHub Logo">
    </a>

    <div class="links" id="links">
      <a class="active" href="#acasa">Acasă</a>
      <a href="#evenimente">Evenimente</a>
      <a href="#favorite">Favorite</a>
      <a href="#mine">Adăugate de mine</a>
      <a href="#leaderboard">Leaderboard</a>
      <a href="#plus">MEH+</a>
      <a href="#familie">Pentru copii</a>
      <a href="#contact">Contact</a>
    </div>

    <div class="nav-cta">
      <div class="auth-buttons" id="authZone">
        <button class="btn primary" id="loginOpen">Login</button>
        <button class="btn" id="registerOpen">Register</button>
      </div>
      <div id="userZone" class="hidden" title="Profil" style="display:flex;gap:8px;align-items:center">
        <span id="username" style="font-weight:800"></span>
        <button class="iconbtn" id="logoutBtn" title="Logout"><i class="fa-solid fa-right-from-bracket"></i></button>
      </div>
      <button id="themeToggle" class="iconbtn" type="button" title="Tema">
        <i id="themeIcon" class="fa-solid fa-moon"></i>
      </button>
      <a class="cta" id="openDlg" href="javascript:void(0)">Adaugă</a>
      <button class="menu-btn" id="menuBtn" aria-label="Meniu"><span></span><span></span><span></span></button>
    </div>
  </div>

  <!-- Mobile -->
  <div class="mobile" id="mobile" aria-hidden="true">
    <a href="#acasa">Acasă</a>
    <a href="#evenimente">Evenimente</a>
    <a href="#favorite">Favorite</a>
    <a href="#mine">Adăugate de mine</a>
    <a href="#leaderboard">Leaderboard</a>
    <a href="#plus">MEH+</a>
    <a href="#familie">Pentru copii</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<!-- HERO -->
<header class="hero" id="acasa">
  <div class="hero-inner">
    <span class="eyebrow">#31A8FF · #001E36 · #FDCC04</span>
    <h1>Descoperă evenimente pentru copii și maturi — într-un singur loc</h1>
    <p>Concerte, conferințe, festivaluri și expoziții. Explorează, filtrează și salvează favoritele. Rapid, prietenos și local pentru Republica Moldova.</p>

    <!-- Search bar -->
    <form class="search" id="searchForm" role="search">
      <label class="sr-only" for="q">Caută</label>
      <input id="q" name="q" type="text" placeholder="Caută (ex: Chișinău, Tech)" autocomplete="on" inputmode="search">
      <label class="sr-only" for="date">Data</label>
      <input id="date" name="date" type="date">
      <label class="sr-only" for="category">Categorie</label>
      <select id="category">
        <option value="">Toate categoriile</option>
        <option>Concerte</option>
        <option>Conferințe</option>
        <option>Festivaluri</option>
        <option>Expoziții</option>
        <option>Sport</option>
        <option>Educație</option>
        <option>Familie</option>
      </select>
      <select id="sortBy" title="Sortează">
        <option value="date">Sortează: Dată</option>
        <option value="price">Sortează: Preț</option>
        <option value="title">Sortează: A → Z</option>
      </select>
      <button id="doSearch" type="submit">Caută</button>
    </form>

