/* ===== Utils ===== */
const RO=new Intl.DateTimeFormat('ro-RO',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
const RO_SHORT=new Intl.DateTimeFormat('ro-RO',{month:'short',day:'2-digit'});
const CURR={MDL:'MDL',EUR:'€',USD:'$',RON:'RON',GBP:'£'};
function fmtDate(d,t){ try{const dt=new Date(d+'T'+(t||'00:00')); return `${RO.format(dt)} · ${dt.toLocaleTimeString('ro-RO',{hour:'2-digit',minute:'2-digit'})}`;}catch{return d+(t?(' '+t):'');} }
function dayBadge(d){try{const dt=new Date(d); return RO_SHORT.format(dt);}catch{return d;}}
function priceBadge(e){return e.priceType==='Free'?'Gratuit':(e.price?`${e.price} ${e.currency}`:'Plătit');}
function by(a,b,k){ if(k==='date'){return (a.date+a.time).localeCompare(b.date+b.time);} if(k==='price'){return (a.price||0)-(b.price||0);} if(k==='title'){return a.title.localeCompare(b.title);} return 0; }
function withinMD(loc){ return /moldova/i.test(loc)||/chișinău|balți|cahul|orhei|soroca|comrat|ung|dubăsari/i.test(loc); }
function el(tag,cls,html){const n=document.createElement(tag); if(cls)n.className=cls; if(html!==undefined)n.innerHTML=html; return n;}

