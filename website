<script>
/* ===== Helpers & basics ===== */
const $=s=>document.querySelector(s), $$=s=>document.querySelectorAll(s);
$('#year').textContent=new Date().getFullYear();
$('#logoLink').addEventListener('click', (e)=>{ e.preventDefault(); scrollTo({top:0,behavior:'smooth'}); });

/* Theme */
const LS_THEME='meh_theme';
const lightLogo='https://ik.imagekit.io/hyfme5nmo/MDEVENTSHUB.png?updatedAt=1754845452470';
const darkLogo ='https://ik.imagekit.io/hyfme5nmo/hubrr.png?updatedAt=1754926794445';
function setTheme(t){
  document.documentElement.setAttribute('data-theme', t);
  localStorage.setItem(LS_THEME,t);
  $('#brandLogo').src = (t==='dark') ? darkLogo : lightLogo;
  $('#themeIcon').className = (t==='dark') ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
  $('#themeToggle').title = (t==='dark') ? 'Comută pe lumină' : 'Comută pe întuneric';
}
const initialTheme = localStorage.getItem(LS_THEME) || (matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');
setTheme(initialTheme);
$('#themeToggle').addEventListener('click',()=>{const now=document.documentElement.getAttribute('data-theme'); setTheme(now==='dark'?'light':'dark');});

/* Mobile menu */
const m=$('#mobile'), mBtn=$('#menuBtn');
mBtn.addEventListener('click',()=>{const open=!m.classList.contains('open');m.classList.toggle('open',open);document.body.style.overflow=open?'hidden':''});
m.addEventListener('click',e=>{if(e.target.tagName==='A')m.classList.remove('open'),document.body.style.overflow='';});

/* Back-to-top */
const backTop=$('#backTop'); addEventListener('scroll',()=>backTop.classList.toggle('show',scrollY>600),{passive:true});
backTop.addEventListener('click',()=>scrollTo({top:0,behavior:'smooth'}));

/* Toast helper */
let tEl; function toast(msg,ok=true){ if(!tEl){tEl=document.createElement('div');tEl.className='toast';document.body.appendChild(tEl)} tEl.textContent=msg; tEl.style.background=ok?'#065f46':'#7f1d1d'; tEl.hidden=false; setTimeout(()=>tEl.hidden=true,2300); }

/* ===== Auth demo local + admin ===== */
const USERS_KEY='meh_users', USER_KEY='meh_current';
const ADMIN_EMAIL='traianb415@gmail.com', ADMIN_PASS='traianb415';

const authDlg=$('#authDlg'), authTitle=$('#authTitle'), switchAuth=$('#switchAuth');
let authMode='login';
$('#loginOpen').addEventListener('click',()=>openAuth('login'));
$('#registerOpen').addEventListener('click',()=>openAuth('register'));
$('#authClose').addEventListener('click',()=>authDlg.close());
function openAuth(mode){authMode=mode; authTitle.textContent=mode==='login'?'Login':'Register'; $('#nameIn').style.display=mode==='login'?'none':'block'; switchAuth.textContent=mode==='login'?'Nu ai cont? Register':'Ai cont? Login'; $('#authMsg').textContent=''; authDlg.showModal();}
switchAuth.addEventListener('click',()=>openAuth(authMode==='login'?'register':'login'));

$('#authForm').addEventListener('submit',e=>{
  e.preventDefault();
  const email=$('#emailIn').value.trim().toLowerCase(), pass=$('#passIn').value.trim(), name=$('#nameIn').value.trim()||email.split('@')[0];
  let users=JSON.parse(localStorage.getItem(USERS_KEY)||'[]');

  // Admin bypass
  if(email===ADMIN_EMAIL && pass===ADMIN_PASS){
    localStorage.setItem(USER_KEY, JSON.stringify({email,name:'Admin',isAdmin:true,ts:Date.now()}));
    syncAuthUI(); authDlg.close(); render(); renderMine(); updateLeaderboard(); toast('Salut, Admin!'); return;
  }

  if(authMode==='register'){
    if(users.find(u=>u.email===email)) { $('#authMsg').textContent='Email deja folosit.'; return; }
    users.push({email,pass,name,isAdmin:false,createdAt:Date.now()});
    localStorage.setItem(USERS_KEY, JSON.stringify(users));
    toast('Cont creat. Te poți loga acum.');
    openAuth('login');
    return;
  }else{
    const u=users.find(u=>u.email===email && u.pass===pass);
    if(!u) { $('#authMsg').textContent='Date greșite.'; return; }
  }
  users=JSON.parse(localStorage.getItem(USERS_KEY)||'[]');
  const u=users.find(x=>x.email===email) || {email,name,isAdmin:false};
  localStorage.setItem(USER_KEY, JSON.stringify({email,name:u.name||name,isAdmin:!!u?.isAdmin,ts:Date.now()}));
  syncAuthUI(); authDlg.close(); render(); renderMine(); updateLeaderboard(); toast('Autentificat!');
});

