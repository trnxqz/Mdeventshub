function applyFilters(){
  let arr=[...state.events];
  const q=(fQ.value||'').trim().toLowerCase();
  const cat=fCat.value||''; const date=fDate.value||'';
  if(state.chip && state.chip!=='Toate') arr=arr.filter(e=>e.category===state.chip);
  if(cat) arr=arr.filter(e=>e.category===cat);
  if(date) arr=arr.filter(e=>e.date===date);
  if(fOnlyMD.checked||state.onlyMD) arr=arr.filter(e=>withinMD(e.location));
  if(q) arr=arr.filter(e=>(e.title+e.location+e.tags.join(' ')).toLowerCase().includes(q));
  arr.sort((a,b)=>by(a,b,state.sortBy));
  return arr;
}

function buildCard(e){
  const tpl=$('#cardTpl'); const node=tpl.content.firstElementChild.cloneNode(true);
  node.dataset.category=e.category;
  node.querySelector('img').src=e.img||'https://images.unsplash.com/photo-1517814644940-3a9c608e25eb';
  node.querySelector('img').alt=e.title;
  node.querySelector('.badge-scope').textContent=dayBadge(e.date);
  node.querySelector('.badge-price').textContent=priceBadge(e);
  node.querySelector('.card-title').textContent=e.title;
  node.querySelector('.date').textContent=fmtDate(e.date,e.time);
  node.querySelector('.location').textContent=e.location;
  node.querySelector('.price-compact').textContent = priceBadge(e);
  const tags=node.querySelector('.tags'); tags.innerHTML=''; (e.tags||[]).forEach(t=>tags.appendChild(el('span','tag',t)));

  const likeBtn=node.querySelector('.likeBtn'); likeBtn.setAttribute('aria-pressed', state.favorites.has(e.id)?'true':'false'); likeBtn.querySelector('span').textContent=state.favorites.has(e.id)?'Unlike':'Like';
  likeBtn.onclick=()=>toggleFav(e.id);
  node.querySelector('.favorite-fab').onclick=()=>toggleFav(e.id);

  const openA=node.querySelector('.openLanding'); openA.href='#event'; openA.onclick=(ev)=>{ev.preventDefault(); openLanding(e);};

  const calBtn=node.querySelector('.calBtn'); calBtn.onclick=()=>downloadICS(e);
  const remBtn=node.querySelector('.remindBtn'); remBtn.onclick=()=>scheduleReminder(e);
  const ttsBtn=node.querySelector('.ttsBtn'); ttsBtn.onclick=()=>speakEvent(e);

  // QR on card
  const qrCanvas=node.querySelector('.qr'); const qrBtn=node.querySelector('.qrBtn'); const qrDlBtn=node.querySelector('.qrDlBtn');
  qrBtn.onclick=()=>{
    if(qrCanvas.style.display==='none'){ QRCode.toCanvas(qrCanvas, e.url||location.href, {width:120,margin:1}, (err)=>{ if(err) toast('QR fail',false); else qrCanvas.style.display='block';}); }
    else qrCanvas.style.display='none';
  };
  qrDlBtn.onclick=()=>{ if(qrCanvas.style.display==='none') qrBtn.click(); setTimeout(()=>{ const url=qrCanvas.toDataURL('image/png'); const a=document.createElement('a'); a.href=url; a.download=`QR_${slug(e.title)}.png`; a.click(); },120); };

  // Trash (admin sau owner)
  const trash=node.querySelector('.trash');
  const u=currentUser();
  if(u && (u.isAdmin || e.owner===u.email)){ trash.style.display='inline-block'; trash.onclick=()=>removeEvent(e.id); }

  return node;
}

function render(){
  const list=applyFilters();
  const grid=$('#grid'); grid.setAttribute('aria-busy','true'); grid.innerHTML='';
  const start=(state.page-1)*state.size, end=Math.min(list.length, start+state.size);
  list.slice(start,end).forEach(e=>grid.appendChild(buildCard(e)));
  $('#prevPage').disabled = state.page<=1;
  $('#nextPage').disabled = end>=list.length;
  grid.setAttribute('aria-busy','false');
  renderFavs(); // sincron la fiecare render
}

/* ===== Favorite ===== */
function toggleFav(id){
  const u=currentUser();
  if(state.favorites.has(id)){ state.favorites.delete(id); addPoints(u?.email||'', -1); }
  else { state.favorites.add(id); addPoints(u?.email||'', +1); }
  saveFavs(); render(); toast(state.favorites.has(id)?'Adăugat la favorite':'Eliminat din favorite');
}
$('#clearFavs').onclick=()=>{ state.favorites.clear(); saveFavs(); renderFavs(); render(); };
function renderFavs(){
  const favGrid=$('#favGrid'); favGrid.innerHTML='';
  const favs=[...state.favorites].map(id=>state.events.find(e=>e.id===id)).filter(Boolean);
  if(!favs.length){ favGrid.innerHTML='<div class="lb-you">Încă nu ai favorite.</div>'; return; }
  favs.forEach(e=>favGrid.appendChild(buildCard(e)));
}

/* ===== Mine ===== */
function renderMine(){
  const u=currentUser(); const mine=$('#mineGrid'); mine.innerHTML='';
  if(!u){ mine.innerHTML=''; return; }
  state.events.filter(e=>e.owner===u.email).forEach(e=>mine.appendChild(buildCard(e)));
}

/* ===== Event Landing ===== */
const evView=$('#eventView'), listView=$('#listView');
$('#backToList').onclick=()=>{ evView.classList.add('hidden'); listView.classList.remove('hidden'); };
function openLanding(e){
  $('#evTitle').textContent=e.title;
  $('#evCover').src=e.img||'https://images.unsplash.com/photo-1517814644940-3a9c608e25eb';
  $('#evWhen').textContent=fmtDate(e.date,e.time);
  $('#evWhere').textContent=e.location;
  const tags=$('#evTags'); tags.innerHTML=''; (e.tags||[]).forEach(t=>tags.appendChild(el('span','tag',t)));
  // actions
  const a=$('#evActions'); a.innerHTML='';
  const btns=[
    ['btn secondary','Vizitează site',()=>{ if(e.url) open(e.url,'_blank'); else toast('Nu există link',false);}],
    ['btn secondary','Copiază link',async()=>{ try{await navigator.clipboard.writeText(e.url||location.href); toast('Link copiat'); }catch{ toast('Nu am putut copia',false);} }],
    ['btn secondary','Deschide harta',()=>{ const q=encodeURIComponent(e.location); open('https://www.google.com/maps/search/?api=1&query='+q,'_blank'); }],
    ['btn','Descarcă .ics',()=>downloadICS(e)],
    ['btn','Generează DOCX',()=>downloadDOCX(e)],
    ['btn ghost','🔊 Citește',()=>speakEvent(e)]
  ];
  btns.forEach(([cls,txt,fn])=>{ const b=el('button',cls,txt); b.type='button'; b.onclick=fn; a.appendChild(b); });

  // Media slider din state.media
  renderMedia(e.id);

  listView.classList.add('hidden'); evView.classList.remove('hidden');
  history.replaceState(null,'','#eveniment');
}

/* ===== Media upload & slider ===== */
$('#photoUpload').addEventListener('change',e=>handleFiles(e.target.files,'photos'));
$('#videoUpload').addEventListener('change',e=>handleFiles(e.target.files,'videos'));
function handleFiles(files,type){
  const cur=$('#evTitle').textContent; const ev=state.events.find(x=>x.title===cur); if(!ev) return;
  state.media[type][ev.id]=state.media[type][ev.id]||[];
  [...files].forEach(f=>{
    const reader=new FileReader();
    reader.onload=()=>{ state.media[type][ev.id].push(reader.result); renderMedia(ev.id); };
    reader.readAsDataURL(f);
  });
}
function renderMedia(id){
  const photos=state.media.photos[id]||[], videos=state.media.videos[id]||[];
  const pWrap=$('#photoSliderWrap'), vWrap=$('#videoListWrap');
  const pTrack=$('#photoTrack'), vTrack=$('#videoTrack'), pDots=$('#photoDots');
  if(photos.length){ pWrap.classList.remove('hidden'); pTrack.innerHTML=photos.map(src=>`<div class="slide"><img src="${src}" alt=""></div>`).join(''); pDots.innerHTML=photos.map((_,i)=>`<span class="dot ${i===0?'active':''}"></span>`).join(''); }
  else { pWrap.classList.add('hidden'); pTrack.innerHTML=''; pDots.innerHTML=''; }
  if(videos.length){ vWrap.classList.remove('hidden'); vTrack.innerHTML=videos.map(src=>`<div class="slide"><video src="${src}" controls></video></div>`).join(''); }
  else { vWrap.classList.add('hidden'); vTrack.innerHTML=''; }

  // simple nav
  const track=pTrack; const dots=pDots.querySelectorAll('.dot'); let idx=0;
  const setActive=()=>{ dots.forEach((d,i)=>d.classList.toggle('active',i===idx)); track.scrollTo({left:track.clientWidth*idx,behavior:'smooth'}); };
  $('#photoSliderWrap .snav-prev').onclick=()=>{ idx=Math.max(0,idx-1); setActive(); };
  $('#photoSliderWrap .snav-next').onclick=()=>{ idx=Math.min(photos.length-1,idx+1); setActive(); };
}

/* ===== Calendar (.ics) ===== */
function downloadICS(e){
  const dtStart=e.date.replace(/-/g,'')+'T'+(e.time||'00:00').replace(':','')+'00';
  const dtEnd=e.date.replace(/-/g,'')+'T'+(e.time||'00:00').replace(':','')+'00';
  const ics=`BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//MoldovaEventsHub//RO
BEGIN:VEVENT
UID:${e.id}@meh
DTSTAMP:${dtStart}Z
DTSTART:${dtStart}Z
DTEND:${dtEnd}Z
SUMMARY:${escapeICS(e.title)}
DESCRIPTION:${escapeICS((e.notes?e.notes+'\n':'')+(e.url||''))}
LOCATION:${escapeICS(e.location)}
END:VEVENT
END:VCALENDAR`.replace(/\n/g,'\r\n');
  const blob=new Blob([ics],{type:'text/calendar;charset=utf-8'});
  const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`${slug(e.title)}.ics`; a.click(); URL.revokeObjectURL(a.href);
}
function escapeICS(s){return String(s||'').replace(/[\n,;\\]/g,m=>({"\\":"\\\\",",":"\\,", ";":"\\;","\n":"\\n"}[m]));}
function slug(s){return s.toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');}

/* ===== DOCX export ===== */
async function downloadDOCX(e){
  try{
    const {Document,Packer,Paragraph,TextRun}=window.docx;
    const doc=new Document({sections:[{children:[
      new Paragraph({children:[new TextRun({text:e.title,bold:true,size:36})]}),
      new Paragraph(''),
      new Paragraph(`Data: ${fmtDate(e.date,e.time)}`),
      new Paragraph(`Locație: ${e.location}`),
      new Paragraph(`Categorie: ${e.category}`),
      new Paragraph(`Preț: ${priceBadge(e)}`),
      new Paragraph(`Etichete: ${(e.tags||[]).join(', ')}`),
      new Paragraph(`Link: ${e.url||'-'}`),
      new Paragraph(''),
      new Paragraph(e.notes||'')
    ]}]});
    const blob=await Packer.toBlob(doc);
    const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`${slug(e.title)}.docx`; a.click(); URL.revokeObjectURL(a.href);
  }catch(err){ console.error(err); toast('DOCX nu a putut fi generat',false); }
}

/* ===== Reminder (demo local) ===== */
function scheduleReminder(e){
  const when=new Date(e.date+'T'+(e.time||'00:00')); const diff=when-Date.now();
  if(diff<=0){ toast('Evenimentul este în trecut',false); return; }
  try{
    setTimeout(()=>{ toast(`Reminder: ${e.title}`); new AudioContext(); /* noop wake */ }, Math.min(diff, 60*1000)); // max 1 minut demo
    toast('Reminder setat (demo local)');
  }catch{ toast('Nu am putut seta reminder',false); }
}

/* ===== TTS ===== */
function speakEvent(e){
  try{
    const u=new SpeechSynthesisUtterance(`${e.title}. ${fmtDate(e.date,e.time)}. ${e.location}. ${e.category}. ${priceBadge(e)}.`);
    u.lang='ro-RO'; speechSynthesis.speak(u);
  }catch{ toast('TTS indisponibil',false); }
}

/* ===== Add / Remove events ===== */
function removeEvent(id){
  if(!confirm('Ștergi evenimentul?')) return;
  state.events=state.events.filter(x=>x.id!==id); saveEvents(); render(); renderMine(); toast('Eveniment șters');
}
$('#openDlg,#openDlg2').forEach?null:undefined; // noop pentru vechi

const evDlg=$('#evDlg');
$('#openDlg').onclick=()=>evDlg.showModal();
$('#openDlg2').onclick=()=>evDlg.showModal();
$('#dlgClose').onclick=()=>evDlg.close();
$('#cancelBtn').onclick=()=>evDlg.close();

// price enable/disable
$('#priceType').addEventListener('change',e=>{
  const paid=e.target.value==='Paid';
  $('#priceIn').disabled=!paid; $('#curIn').disabled=!paid;
});
// live preview
['tIn','dIn','timeIn','locIn','scopeIn','catIn'].forEach(id=>$('#'+id).addEventListener('input',updatePreview));
function updatePreview(){
  const t=$('#tIn').value||'—'; const d=$('#dIn').value||''; const tm=$('#timeIn').value||''; const loc=$('#locIn').value||''; const scope=$('#scopeIn').value||''; const cat=$('#catIn').value||'';
  $('#prevTitle').textContent=t; $('#prevMeta').textContent=[dayBadge(d), tm, loc, scope, cat].filter(Boolean).join(' · ');
  const pTags=$('#prevTags'); pTags.innerHTML=''; (cat?[cat]:[]).forEach(x=>pTags.appendChild(el('span','tag',x)));
}
updatePreview();

$('#evForm').addEventListener('submit',e=>{
  e.preventDefault();
  const u=currentUser();
  const paid=$('#priceType').value==='Paid';
  const ev={
    id:nextId(),
    title:$('#tIn').value.trim(),
    date:$('#dIn').value,
    time:$('#timeIn').value||'',
    location:$('#locIn').value.trim(),
    category:$('#catIn').value,
    priceType: paid?'Paid':'Free',
    price: paid? Number($('#priceIn').value||0):0,
    currency: paid? $('#curIn').value : 'MDL',
    scope:$('#scopeIn').value,
    img:($('#imgIn').value||'').trim(),
    tags: [$('#catIn').value, $('#scopeIn').value].filter(Boolean),
    url:($('#urlIn').value||'').trim(),
    owner:u?.email||null,
    notes:($('#notesIn').value||'').trim()
  };
  state.events.push(ev); saveEvents(); evDlg.close(); render(); renderMine(); toast('Eveniment adăugat');
  if(u?.email) addPoints(u.email, +5);
  // reset form
  e.target.reset(); $('#priceIn').disabled=true; $('#curIn').disabled=true; updatePreview();
});

/* ===== Newsletter/Forms ===== */
$('#familyNL').addEventListener('submit',e=>{e.preventDefault(); toast('Te-am abonat la noutăți pentru părinți!'); e.target.reset();});
$('#mediaForm').addEventListener('submit',e=>{e.preventDefault(); toast('Mulțumim! Revenim cu un email în 24h.'); e.target.reset();});
$('#fminiBtn').onclick=()=>{ const v=$('#fmini').value.trim(); if(!v) return; toast('Abonare reușită!'); $('#fmini').value=''; };
$('#fminiBtn2').onclick=()=>{ const v=$('#fmini2').value.trim(); if(!v) return; toast('Abonare reușită!'); $('#fmini2').value=''; };

/* ===== Share via URL (import filtre) ===== */
(function restoreFromURL(){
  const u=new URL(location.href);
  fQ.value=u.searchParams.get('q')||'';
  fDate.value=u.searchParams.get('date')||'';
  fCat.value=u.searchParams.get('cat')||'';
  fSort.value=u.searchParams.get('sort')||'date';
  fOnlyMD.checked=u.searchParams.get('only')==='1';
})();

/* ===== Init ===== */
render();

</script>



